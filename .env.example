# Copy this file to .env and set OPENROUTER_API_KEY. Do not commit .env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_EXTRACT=deepseek/deepseek-v4.1-flash
LLM_MODEL_AGENT=openai/gpt-5-mini
LLM_MODEL_SUMMARY=openai/gpt-5-nano
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
# pgvector (default) or qdrant. Only one store runs at a time.
VECTOR_STORE=pgvector
QDRANT_URL=http://qdrant:6333
AGENT_MAX_TOOL_CALLS=8
CHAT_RATE_LIMIT=20/minute
# Set a strong value on the server. Compose uses it for Postgres and for DATABASE_URL.
POSTGRES_PASSWORD=lensor
# Compose sets DATABASE_URL for the api container. Set it here only to run the API outside Compose.
DATABASE_URL=postgresql+asyncpg://lensor:lensor@localhost:5433/lensor
